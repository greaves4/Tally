{
  "expo": {
    "name": "Tally",
    "slug": "tally",
    "scheme": "tally",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#151515"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gerardogreaves.tally",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Tally lee tus pasos para mostrar tu progreso y calcular tu deuda de pasos."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151515",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "react-native-health",
        {
          "healthSharePermission": "Tally lee tus pasos para calcular tu progreso diario."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba3d6d3b-2b95-47e8-8f56-a9fa4bdb9d4f"
      }
    }
  }
}
